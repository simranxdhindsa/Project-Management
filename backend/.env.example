# Velocity - Backend Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Server Configuration
# ===========================================
# Development: PORT=8080, ENVIRONMENT=development
# Production:  PORT=8081 (nginx owns 8080), ENVIRONMENT=production
PORT=8080
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ===========================================
# Google OAuth Configuration
# ===========================================
# Get these from: https://console.cloud.google.com/apis/credentials
# Add authorized redirect URIs:
#   - http://localhost:5173/auth/callback  (development)
#   - https://your-production-domain.com/auth/callback  (production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# ===========================================
# JWT Configuration
# ===========================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key

# ===========================================
# Database Configuration (NeonDB)
# ===========================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ===========================================
# Slack Integration (Optional)
# ===========================================
# Create a Slack App at: https://api.slack.com/apps
# Required Bot Token Scopes: channels:history, channels:read, users:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ===========================================
# Asana Integration (Optional)
# ===========================================
# Create a Personal Access Token at: https://app.asana.com/0/developer-console
ASANA_PAT=your-asana-personal-access-token
ASANA_PROJECT_ID=your-asana-project-id

# ===========================================
# YouTrack Integration (Optional)
# ===========================================
YOUTRACK_BASE_URL=https://your-instance.youtrack.cloud
YOUTRACK_TOKEN=perm-your-youtrack-token
YOUTRACK_PROJECT_ID=YOUR_PROJECT_ID

# ===========================================
# AI Configuration (Choose ONE provider)
# ===========================================
# AI_PROVIDER options: "groq" (default), "openai", "gemini"
AI_PROVIDER=groq

# Groq AI (FREE - 30 req/min, 14,400/day)
# Get free API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Google Gemini AI (Free tier with quotas)
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
