{
  "name": "velocity-root",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"go,vite\" --prefix-colors \"cyan,magenta\" \"cd backend && air\" \"cd frontend && npm run dev\"",
    "fe": "cd frontend && npm run dev",
    "be": "cd backend && air",
    "kill": "npx kill-port 8080",
    "restart": "npx kill-port 8080 && cd backend && air"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "shadcn": "^4.7.0"
  }
}
